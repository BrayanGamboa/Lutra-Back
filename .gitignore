## #######################################################################
## .gitignore para C# y .NET
## #######################################################################

# --- Salidas de compilación (Artifacts) ---
bin/
obj/
[Bb]in/
[Oo]bj/
out/

# --- Archivos de configuración de usuario y caché de Visual Studio ---
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs

# --- Secretos y configuraciones locales (¡Muy Importante!) ---
# Ignora las configuraciones locales de desarrollo para no subir contraseñas o Keys.
appsettings.Development.json
appsettings.Local.json
secrets.json
.env

# --- Paquetes NuGet ---
*.nupkg
# La carpeta global de paquetes (si se restaura localmente en el proyecto)
packages/
# Archivos de caché y logs de NuGet
project.lock.json
project.fragment.lock.json
artifacts/

# --- Archivos de Base de Datos locales ---
*.mdf
*.ldf
*.sdf
*.db
*.sqlite

# --- Archivos de depuración y diagnóstico ---
*.pdb
*.log
*.crash
*.dump

# --- Sistema Operativo ---
.DS_Store
Thumbs.db